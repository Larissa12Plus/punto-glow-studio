# =====================================================================
# Plantilla de secrets para Punto Glow Studio
# ---------------------------------------------------------------------
# COMO USAR:
#   1. Copia este archivo y renombralo a "secrets.toml" (sin .example),
#      en esta misma carpeta: .streamlit/secrets.toml
#   2. Reemplaza los valores de ejemplo con tu cadena de conexion real
#      de Supabase (ver GUIA_SUPABASE.md, pasos 3 y 4).
#
# SEGURIDAD:
#   - NUNCA subas secrets.toml a GitHub (ya esta en .gitignore).
#   - Este archivo .example NO debe contener credenciales reales.
# =====================================================================

[supabase]
# Cadena de conexion a tu base de datos PostgreSQL en Supabase.
# Formato SQLAlchemy + psycopg2:
#   postgresql+psycopg2://USUARIO:PASSWORD@HOST:PUERTO/BASE_DE_DATOS
#
# Donde:
#   USUARIO        -> normalmente "postgres"
#   PASSWORD       -> la contrasena que elegiste al crear el proyecto
#   HOST           -> algo como db.xxxxxxxxxxxx.supabase.co
#   PUERTO         -> 5432
#   BASE_DE_DATOS  -> normalmente "postgres"
db_url = "postgresql+psycopg2://postgres:TU_PASSWORD@TU_HOST:5432/postgres"
